# ==========================================
# LabelSpy - Шаблон конфигурации окружения
# Скопируйте этот файл в .env и укажите свои значения:
# cp .env.example .env
# ==========================================

# 1. ОБЯЗАТЕЛЬНЫЕ КЛЮЧИ API
# Токен бота Telegram, полученный у @BotFather
TELEGRAM_TOKEN=

# API-ключ Google Gemini, полученный в Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=


# 2. БАЗА ДАННЫХ (НЕОБЯЗАТЕЛЬНО)
# Строка подключения к PostgreSQL (Supabase, Neon, Render PostgreSQL и т.д.)
# Если оставить пустым — автоматически используется локальная база данных SQLite (labelspy.db)
DATABASE_URL=


# 3. АДМИНИСТРАТОР (НЕОБЯЗАТЕЛЬНО)
# Ваш числовой Telegram ID (можно узнать у бота @userinfobot)
# Если не указан — админ-команды (/stats, тестовый премиум) отключаются
ADMIN_ID=


# 4. БРЕНДИНГ И НАЗВАНИЕ
# Название вашего бота, отображаемое в шапке, текстах и на карточке
BOT_NAME=LabelSpy

# Юзернейм бота в Telegram (без символа @) для подписи на карточке-отчёте (например: MyCustomBot)
# Если оставить пустым — юзернейм на карточке-отчёте не отображается
BOT_USERNAME=


# 5. НАСТРОЙКИ МОДЕЛЕЙ GOOGLE GEMINI
# Список моделей с поддержкой Vision через запятую в порядке приоритета
# Если первая модель временно недоступна, бот автоматически переключится на следующую
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite


# 6. ЛИМИТЫ И ТАРИФЫ
# Количество бесплатных сканирований в календарный месяц
FREE_SCANS_PER_MONTH=5

# Стоимость премиум-подписки в Telegram Stars (валюта XTR)
PREMIUM_STARS_PRICE=50

# Длительность премиум-подписки в днях
PREMIUM_SUBSCRIPTION_DAYS=30

# Длительность тестового премиума для администратора в днях
DEMO_PREMIUM_DAYS=7

# Минимальная задержка между повторными запросами одного пользователя (в секундах)
SCAN_COOLDOWN_SECONDS=3


# 7. ЭМОДЗИ И ОФОРМЛЕНИЕ
# Использовать кастомные Telegram Premium эмодзи (true/false)
# Если false — бот использует универсальные стандартные Unicode-эмодзи (рекомендуется для новых ботов)
USE_CUSTOM_EMOJI=false
